# Vigil Backend — Environment Variables
# Run `npm run reveal-secrets` from the repo root to scaffold this file.
# NEVER commit .env to git.

# Pipeline data source: seed (default) or aws.
#   seed: deterministic sample data. No AWS calls, alerts are simulated (no email).
#   aws:  live AWS Glue via boto3 and real SendGrid email. Needs the AWS and
#         SendGrid variables below.
DATA_SOURCE=seed

# Linked from alert emails
FRONTEND_URL=https://vigil-etl.vercel.app

# AWS (DATA_SOURCE=aws only): IAM user with read-only Glue access
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# SendGrid (DATA_SOURCE=aws only): anomaly alert emails
SENDGRID_API_KEY=
ALERT_SENDER_EMAIL=

# PostgreSQL — use Supabase Session Mode pooler (port 5432, NOT 6543)
DATABASE_URL=postgresql://username:password@host:port/database

# JWT — generate with: openssl rand -hex 32
VIGIL_JWT_SECRET=

# Admin seed (used by seed_admin.py only)
VIGIL_ADMIN_EMAIL=
VIGIL_ADMIN_PASSWORD=

# Glue catalog + Athena (DATA_SOURCE=aws only): set after deploying infra/vigil-stack.yaml
# See infra/README.md for values
GLUE_DATABASE_NAME=vigil_analytics_nonprod
GLUE_TABLE_NAME=vigil_sales_daily
ATHENA_RESULTS_BUCKET=vigil-athena-results-<account-id>-nonprod

# CORS — comma-separated list of allowed frontend origins
# Local dev: http://localhost:5173
# Production: your Vercel URL
ALLOWED_ORIGINS=http://localhost:5173
